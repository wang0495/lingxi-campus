# 灵犀·校园 环境变量配置
# 复制此文件为 .env 并填入实际值

# ─── LLM 配置 ────────────────────────────────────────────────────
# DeepSeek API
LLM_API_URL=https://api.deepseek.com
LLM_API_KEY=your-deepseek-api-key-here
LLM_MODEL=deepseek-v4-flash

# ─── Embedding 配置 ───────────────────────────────────────────────
# SiliconFlow Embedding API
EMBEDDING_API_URL=https://api.siliconflow.cn/v1/embeddings
EMBEDDING_API_KEY=your-siliconflow-api-key-here
EMBEDDING_MODEL=BAAI/bge-m3

# ─── Vision 配置 ──────────────────────────────────────────────────
VISION_API_URL=https://api.siliconflow.cn/v1/chat/completions
VISION_API_KEY=${EMBEDDING_API_KEY}
VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct

# ─── STT 配置 ─────────────────────────────────────────────────────
STT_API_URL=https://api.siliconflow.cn/v1/audio/transcriptions
STT_API_KEY=${EMBEDDING_API_KEY}
STT_MODEL=FunAudioLLM/SenseVoiceSmall

# ─── SiliconFlow 轻量模型 ─────────────────────────────────────────
SF_LLM_URL=https://api.siliconflow.cn/v1/chat/completions
SF_API_KEY=${EMBEDDING_API_KEY}
SF_MODEL=Qwen/Qwen2.5-7B-Instruct

# ─── 安全配置 ─────────────────────────────────────────────────────
# JWT 密钥（生产环境请使用强随机字符串）
JWT_SECRET=your-jwt-secret-key-here

# ─── CORS 配置 ────────────────────────────────────────────────────
# 允许的前端域名，多个用逗号分隔
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:8000

# ─── 服务配置 ─────────────────────────────────────────────────────
# 服务端口
PORT=8002
# 调试模式（生产环境设为 false）
DEBUG=false
